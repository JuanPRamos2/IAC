# Copia este archivo a .env y completa los valores.
# Nunca subas .env ni claves reales al repositorio.

# Flask
FLASK_ENV=development
FLASK_SECRET_KEY=cambia-esta-clave-en-produccion
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# OpenRouter / DeepSeek (clasificador de servicios en la nube)
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
DEEPSEEK_MODEL=deepseek/deepseek-chat
MAX_TOKENS=50
TEMPERATURE=0.1

# Validación de texto del clasificador
MIN_TEXT_LENGTH=3
MAX_TEXT_LENGTH=1000
