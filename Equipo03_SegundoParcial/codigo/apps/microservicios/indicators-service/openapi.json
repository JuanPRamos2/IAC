{
  "openapi": "3.0.3",
  "info": {
    "title": "indicators-service — Bienestar Nexum",
    "version": "1.0.0",
    "description": "Servicio de calculo y agregacion de indicadores organizacionales de estres, carga y bienestar con garantia k >= 5 (Puerto 8113)."
  },
  "servers": [
    {
      "url": "http://localhost:8113",
      "description": "Desarrollo local"
    },
    {
      "url": "/",
      "description": "Mismo origen"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/indicadores": {
      "get": {
        "summary": "Lista el catalogo de metricas e indicadores de bienestar autorizados",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "formato",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "xml"
              ]
            },
            "description": "Alternativa al encabezado Accept para solicitar JSON o XML."
          }
        ],
        "responses": {
          "200": {
            "description": "Catalogo de indicadores",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListaIndicadores"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/ListaIndicadores"
                },
                "example": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<indicadores_catalogo xmlns=\"http://nexum.com.mx/bienestar/v1\">\n  <indicadores>\n    <indicador>\n      <clave>IND_ESTRES</clave>\n      <nombre>Percepcion de Estres Laboral</nombre>\n      <dimension_id>DIM-01</dimension_id>\n      <unidad_medida>escala_1_5</unidad_medida>\n      <umbral_alerta>3.8</umbral_alerta>\n    </indicador>\n  </indicadores>\n  <total>1</total>\n</indicadores_catalogo>"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/SolicitudInvalida"
          },
          "401": {
            "$ref": "#/components/responses/NoAutenticado"
          },
          "403": {
            "$ref": "#/components/responses/SinPermiso"
          },
          "404": {
            "$ref": "#/components/responses/NoEncontrado"
          },
          "422": {
            "$ref": "#/components/responses/ValidacionFallida"
          },
          "429": {
            "$ref": "#/components/responses/LimiteExcedido"
          },
          "500": {
            "$ref": "#/components/responses/ErrorInterno"
          }
        }
      }
    },
    "/api/v1/indicadores/agregados": {
      "get": {
        "summary": "Consulta indicadores agregados por campania y unidad con umbral k >= 5",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "campania_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "unidad_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "formato",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "xml"
              ]
            },
            "description": "Alternativa al encabezado Accept para solicitar JSON o XML."
          }
        ],
        "responses": {
          "200": {
            "description": "Indicadores agregados protegidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaAgregados"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaAgregados"
                },
                "example": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<agregados_respuesta xmlns=\"http://nexum.com.mx/bienestar/v1\">\n  <campania_id>CAMP-2026-S1</campania_id>\n  <unidad_id>UO-OPERACIONES</unidad_id>\n  <indicadores/>\n  <total>0</total>\n  <fuente>postgresql_protegido</fuente>\n</agregados_respuesta>"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/SolicitudInvalida"
          },
          "401": {
            "$ref": "#/components/responses/NoAutenticado"
          },
          "403": {
            "$ref": "#/components/responses/SinPermiso"
          },
          "404": {
            "$ref": "#/components/responses/NoEncontrado"
          },
          "422": {
            "$ref": "#/components/responses/ValidacionFallida"
          },
          "429": {
            "$ref": "#/components/responses/LimiteExcedido"
          },
          "500": {
            "$ref": "#/components/responses/ErrorInterno"
          }
        }
      }
    },
    "/api/v1/indicadores/historico": {
      "get": {
        "summary": "Consulta evolucion temporal e historico de indicadores para una unidad",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "unidad_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "dimension_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "formato",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "xml"
              ]
            },
            "description": "Alternativa al encabezado Accept para solicitar JSON o XML."
          }
        ],
        "responses": {
          "200": {
            "description": "Serie historica de indicadores",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaHistorico"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaHistorico"
                },
                "example": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<historico_respuesta xmlns=\"http://nexum.com.mx/bienestar/v1\">\n  <unidad_id>UO-OPERACIONES</unidad_id>\n  <dimension_id>TODAS</dimension_id>\n  <puntos/>\n  <total>0</total>\n</historico_respuesta>"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/SolicitudInvalida"
          },
          "401": {
            "$ref": "#/components/responses/NoAutenticado"
          },
          "403": {
            "$ref": "#/components/responses/SinPermiso"
          },
          "404": {
            "$ref": "#/components/responses/NoEncontrado"
          },
          "422": {
            "$ref": "#/components/responses/ValidacionFallida"
          },
          "429": {
            "$ref": "#/components/responses/LimiteExcedido"
          },
          "500": {
            "$ref": "#/components/responses/ErrorInterno"
          }
        }
      }
    },
    "/api/v1/indicadores/calcular": {
      "post": {
        "summary": "Dispara procesamiento y consolidacion de indicadores agregados",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "formato",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "xml"
              ]
            },
            "description": "Alternativa al encabezado Accept para solicitar JSON o XML."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SolicitudCalculoIndicadores"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Calculo completado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaCalculoIndicadores"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaCalculoIndicadores"
                },
                "example": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<calculo_respuesta xmlns=\"http://nexum.com.mx/bienestar/v1\">\n  <resultado>CALCULADO</resultado>\n  <campania_id>CAMP-2026-S1</campania_id>\n  <unidades_consolidadas>5</unidades_consolidadas>\n  <mensaje>Indicadores procesados bajo estricto cumplimiento del umbral k &gt;= 5.</mensaje>\n</calculo_respuesta>"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/SolicitudInvalida"
          },
          "401": {
            "$ref": "#/components/responses/NoAutenticado"
          },
          "403": {
            "$ref": "#/components/responses/SinPermiso"
          },
          "404": {
            "$ref": "#/components/responses/NoEncontrado"
          },
          "422": {
            "$ref": "#/components/responses/ValidacionFallida"
          },
          "429": {
            "$ref": "#/components/responses/LimiteExcedido"
          },
          "500": {
            "$ref": "#/components/responses/ErrorInterno"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token JWT emitido por auth-service."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "codigo",
              "mensaje",
              "detalles",
              "correlacion_id"
            ],
            "properties": {
              "codigo": {
                "type": "string"
              },
              "mensaje": {
                "type": "string"
              },
              "detalles": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "campo": {
                      "type": "string"
                    },
                    "problema": {
                      "type": "string"
                    }
                  }
                }
              },
              "correlacion_id": {
                "type": "string"
              }
            }
          }
        }
      },
      "Indicador": {
        "type": "object",
        "properties": {
          "clave": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "dimension_id": {
            "type": "string",
            "nullable": true
          },
          "unidad_medida": {
            "type": "string"
          },
          "umbral_alerta": {
            "type": "number"
          }
        }
      },
      "ListaIndicadores": {
        "type": "object",
        "properties": {
          "indicadores": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Indicador"
            }
          },
          "total": {
            "type": "integer"
          }
        }
      },
      "AgregadoIndicador": {
        "type": "object",
        "properties": {
          "clave": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "dimension_id": {
            "type": "string",
            "nullable": true
          },
          "valor": {
            "type": "number",
            "nullable": true
          },
          "n_observaciones": {
            "type": "integer"
          },
          "k_umbral": {
            "type": "integer"
          },
          "suprimido_por_umbral": {
            "type": "boolean"
          },
          "nivel_riesgo": {
            "type": "string"
          },
          "precision": {
            "type": "string"
          }
        }
      },
      "RespuestaAgregados": {
        "type": "object",
        "properties": {
          "campania_id": {
            "type": "string"
          },
          "unidad_id": {
            "type": "string"
          },
          "indicadores": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AgregadoIndicador"
            }
          },
          "total": {
            "type": "integer"
          },
          "fuente": {
            "type": "string"
          }
        }
      },
      "PuntoHistoricoIndicador": {
        "type": "object",
        "properties": {
          "campania_id": {
            "type": "string"
          },
          "campania": {
            "type": "string"
          },
          "fecha": {
            "type": "string",
            "format": "date"
          },
          "dimension_id": {
            "type": "string"
          },
          "valor": {
            "type": "number",
            "nullable": true
          },
          "suprimido_por_umbral": {
            "type": "boolean"
          },
          "n_observaciones": {
            "type": "integer"
          }
        }
      },
      "RespuestaHistorico": {
        "type": "object",
        "properties": {
          "unidad_id": {
            "type": "string"
          },
          "dimension_id": {
            "type": "string"
          },
          "puntos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PuntoHistoricoIndicador"
            }
          },
          "total": {
            "type": "integer"
          }
        }
      },
      "SolicitudCalculoIndicadores": {
        "type": "object",
        "required": [
          "campania_id"
        ],
        "properties": {
          "campania_id": {
            "type": "string"
          }
        }
      },
      "RespuestaCalculoIndicadores": {
        "type": "object",
        "properties": {
          "resultado": {
            "type": "string"
          },
          "campania_id": {
            "type": "string"
          },
          "unidades_consolidadas": {
            "type": "integer"
          },
          "mensaje": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "SolicitudInvalida": {
        "description": "Parametro mal formado.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "codigo": "PARAMETRO_INVALIDO",
                "mensaje": "'tamano' debe estar entre 1 y 100.",
                "detalles": [],
                "correlacion_id": "a1b2c3d4e5f60718"
              }
            }
          },
          "application/xml": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<error_respuesta xmlns=\"http://nexum.com.mx/bienestar/v1\">\n  <error>\n    <codigo>PARAMETRO_INVALIDO</codigo>\n    <mensaje>'tamano' debe estar entre 1 y 100.</mensaje>\n    <detalles/>\n    <correlacion_id>a1b2c3d4e5f60718</correlacion_id>\n  </error>\n</error_respuesta>"
          }
        }
      },
      "NoAutenticado": {
        "description": "Falta el token, es invalido, expiro o la sesion fue revocada.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "codigo": "SESION_REVOCADA",
                "mensaje": "La sesion fue cerrada o revocada.",
                "detalles": [],
                "correlacion_id": "a1b2c3d4e5f60718"
              }
            }
          },
          "application/xml": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<error_respuesta xmlns=\"http://nexum.com.mx/bienestar/v1\">\n  <error>\n    <codigo>SESION_REVOCADA</codigo>\n    <mensaje>La sesion fue cerrada o revocada.</mensaje>\n    <detalles/>\n    <correlacion_id>a1b2c3d4e5f60718</correlacion_id>\n  </error>\n</error_respuesta>"
          }
        }
      },
      "SinPermiso": {
        "description": "El perfil no tiene el permiso necesario.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "codigo": "SIN_PERMISO",
                "mensaje": "El perfil Colaborador no tiene ninguno de los permisos requeridos.",
                "detalles": [],
                "correlacion_id": "a1b2c3d4e5f60718"
              }
            }
          },
          "application/xml": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<error_respuesta xmlns=\"http://nexum.com.mx/bienestar/v1\">\n  <error>\n    <codigo>SIN_PERMISO</codigo>\n    <mensaje>El perfil Colaborador no tiene ninguno de los permisos requeridos.</mensaje>\n    <detalles/>\n    <correlacion_id>a1b2c3d4e5f60718</correlacion_id>\n  </error>\n</error_respuesta>"
          }
        }
      },
      "NoEncontrado": {
        "description": "El recurso no existe.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "codigo": "RECURSO_NO_ENCONTRADO",
                "mensaje": "La ruta solicitada no existe en este servicio.",
                "detalles": [],
                "correlacion_id": "a1b2c3d4e5f60718"
              }
            }
          },
          "application/xml": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<error_respuesta xmlns=\"http://nexum.com.mx/bienestar/v1\">\n  <error>\n    <codigo>RECURSO_NO_ENCONTRADO</codigo>\n    <mensaje>La ruta solicitada no existe en este servicio.</mensaje>\n    <detalles/>\n    <correlacion_id>a1b2c3d4e5f60718</correlacion_id>\n  </error>\n</error_respuesta>"
          }
        }
      },
      "ValidacionFallida": {
        "description": "La solicitud trae campos invalidos. Se devuelven TODOS los problemas de una vez, no solo el primero.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "codigo": "VALIDACION",
                "mensaje": "La solicitud tiene campos invalidos.",
                "detalles": [],
                "correlacion_id": "a1b2c3d4e5f60718"
              }
            }
          },
          "application/xml": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<error_respuesta xmlns=\"http://nexum.com.mx/bienestar/v1\">\n  <error>\n    <codigo>VALIDACION</codigo>\n    <mensaje>La solicitud tiene campos invalidos.</mensaje>\n    <detalles/>\n    <correlacion_id>a1b2c3d4e5f60718</correlacion_id>\n  </error>\n</error_respuesta>"
          }
        }
      },
      "LimiteExcedido": {
        "description": "Se rebaso el limite de consumo.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "codigo": "LIMITE_EXCEDIDO",
                "mensaje": "Mas de 120 peticiones por 60 segundos.",
                "detalles": [],
                "correlacion_id": "a1b2c3d4e5f60718"
              }
            }
          },
          "application/xml": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<error_respuesta xmlns=\"http://nexum.com.mx/bienestar/v1\">\n  <error>\n    <codigo>LIMITE_EXCEDIDO</codigo>\n    <mensaje>Mas de 120 peticiones por 60 segundos.</mensaje>\n    <detalles/>\n    <correlacion_id>a1b2c3d4e5f60718</correlacion_id>\n  </error>\n</error_respuesta>"
          }
        }
      },
      "ErrorInterno": {
        "description": "Falla no prevista. Fuera de developer no se devuelve el detalle.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "codigo": "ERROR_INTERNO",
                "mensaje": "Error interno del servicio. El evento quedo registrado.",
                "detalles": [],
                "correlacion_id": "a1b2c3d4e5f60718"
              }
            }
          },
          "application/xml": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<error_respuesta xmlns=\"http://nexum.com.mx/bienestar/v1\">\n  <error>\n    <codigo>ERROR_INTERNO</codigo>\n    <mensaje>Error interno del servicio. El evento quedo registrado.</mensaje>\n    <detalles/>\n    <correlacion_id>a1b2c3d4e5f60718</correlacion_id>\n  </error>\n</error_respuesta>"
          }
        }
      }
    }
  }
}
