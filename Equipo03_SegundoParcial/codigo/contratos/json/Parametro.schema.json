{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexum.com.mx/bienestar/contratos/Parametro.schema.json",
  "title": "Parametro",
  "description": "Generado desde el contrato OpenAPI de configuration-service. No editar a mano: ejecutar contratos/generar_json.py.",
  "properties": {
    "clave": {
      "example": "k_umbral_minimo",
      "type": "string"
    },
    "congelar_en_campania_abierta": {
      "type": "boolean"
    },
    "descripcion": {
      "type": "string"
    },
    "justificacion": {
      "description": "Por que el valor es ese. Viaja con el parametro porque un umbral sin motivo escrito no se puede defender ni discutir.",
      "type": "string"
    },
    "maximo": {
      "type": [
        "number",
        "null"
      ]
    },
    "minimo": {
      "type": [
        "number",
        "null"
      ]
    },
    "modificable": {
      "description": "Si se puede cambiar AHORA MISMO. Se calcula aqui a proposito: un cliente que tuviera que deducirlo cruzando la lista de campanias abiertas con una columna booleana lo deduciria mal.",
      "type": "boolean"
    },
    "motivo_limite": {
      "type": [
        "string",
        "null"
      ]
    },
    "motivo_no_modificable": {
      "type": [
        "string",
        "null"
      ]
    },
    "unidad": {
      "type": [
        "string",
        "null"
      ]
    },
    "valor": {
      "type": "number"
    }
  },
  "type": "object",
  "$defs": {
    "CambioParametro": {
      "description": "Una fila del historial. Trae el valor ANTERIOR: sin el no se puede reconstruir con que umbral se publico cada campania, que es para lo unico que existiria el historial.",
      "properties": {
        "actor_usuario_id": {
          "type": "string"
        },
        "cambio_id": {
          "type": "integer"
        },
        "campanias_abiertas": {
          "description": "Que campanias estaban abiertas cuando se hizo el cambio. Permite saber si afecto a una medicion en curso, y no se puede reconstruir despues porque los estados de campania cambian.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "fecha_cambio": {
          "format": "date-time",
          "type": "string"
        },
        "justificacion": {
          "type": "string"
        },
        "valor_anterior": {
          "type": [
            "number",
            "null"
          ]
        },
        "valor_nuevo": {
          "type": "number"
        }
      },
      "type": "object"
    },
    "Error": {
      "properties": {
        "error": {
          "properties": {
            "codigo": {
              "description": "Codigo estable; el cliente programa contra esto, no contra el mensaje.",
              "example": "SIN_PERMISO",
              "type": "string"
            },
            "correlacion_id": {
              "example": "a1b2c3d4e5f60718",
              "type": "string"
            },
            "detalles": {
              "items": {
                "properties": {
                  "campo": {
                    "example": "correo",
                    "type": "string"
                  },
                  "problema": {
                    "example": "no es un correo valido",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "type": "array"
            },
            "mensaje": {
              "example": "El perfil Colaborador no tiene el permiso requerido.",
              "type": "string"
            }
          },
          "required": [
            "codigo",
            "mensaje"
          ],
          "type": "object"
        }
      },
      "required": [
        "error"
      ],
      "type": "object"
    },
    "Paginacion": {
      "properties": {
        "pagina": {
          "example": 1,
          "type": "integer"
        },
        "tamano": {
          "example": 20,
          "type": "integer"
        },
        "tiene_anterior": {
          "example": false,
          "type": "boolean"
        },
        "tiene_siguiente": {
          "example": true,
          "type": "boolean"
        },
        "total": {
          "example": 143,
          "type": "integer"
        },
        "total_paginas": {
          "example": 8,
          "type": "integer"
        }
      },
      "type": "object"
    }
  }
}
